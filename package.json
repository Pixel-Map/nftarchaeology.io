{
  "name": "nft-archaeology",
  "homepage": "https://nftarchaeology.io",
  "version": "1.1.0",
  "private": true,
  "dependencies": {
    "ajv": "^8.20.0",
    "js-yaml": "^4.3.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-markdown": "^8.0.1",
    "react-router-dom": "^6.2.1",
    "react-scripts": "5.0.0"
  },
  "scripts": {
    "data:build": "node scripts/build-data.mjs",
    "prestart": "npm run data:build",
    "start": "react-scripts start",
    "prebuild": "npm run data:build",
    "build": "react-scripts build",
    "postbuild": "node scripts/prerender.mjs && node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "preview": "node scripts/preview.mjs",
    "pretest": "npm run data:build",
    "test": "react-scripts test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
